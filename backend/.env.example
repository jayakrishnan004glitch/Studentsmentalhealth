# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development

# Supabase Postgres. Use the pooler connection string (transaction mode, port 6543)
# from Supabase dashboard → Connect, with the asyncpg driver:
#   postgresql+asyncpg://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres
# Local Supabase (`npx supabase start`):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL (dashboard → Project Settings → API). Local: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Leave EMPTY to verify tokens with the project's public signing keys (JWKS) — recommended.
# Only set this if your project still uses the legacy shared JWT secret.
SUPABASE_JWT_SECRET=

# Bump when terms/privacy text changes; students are asked to consent again.
CURRENT_POLICY_VERSION=2026-11-v1

# JSON list of allowed browser origins (Flutter web dev server, Next.js portal).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Used by the tests only (a throwaway Postgres, see README).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54339/mh_test
